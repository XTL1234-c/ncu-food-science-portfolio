# ==================================================
#   个人作品集仓库 .gitignore 模板
#   适配 Windows / macOS / Linux 多平台开发
# ==================================================

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
ehthumbs_vista.db
$RECYCLE.BIN/
System Volume Information/

# ---------- 编辑器 / IDE ----------
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
*.sublime-project
*.sublime-workspace
.vs/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version
*.egg-info/
.pytest_cache/

# ---------- Node ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ---------- Java ----------
*.class
*.jar
*.war
*.ear
target/
.gradle/
build/

# ---------- Office 临时锁文件 ----------
~$*.docx
~$*.xlsx
~$*.pptx
~$*.doc
~$*.xls
~$*.ppt
*.tmp

# ---------- 日志 / 临时 / 备份 ----------
*.log
*.tmp
*.bak
*.cache
*.pid
*.seed
*.pid.lock

# ---------- 环境与凭据（绝不能提交！） ----------
.env
.env.local
.env.*.local
*.pem
*.key
secrets.yaml

# ---------- 常见压缩 / 大文件 ----------
*.zip
*.rar
*.7z
*.tar.gz
*.psd
*.ai
*.iso
*.dmg
*.exe
*.dll

# ---------- 实验报告常见可忽略项（按需启用） ----------
# *.csv
# *.xlsx
